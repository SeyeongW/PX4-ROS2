# --- ROS 2 기본 무시 파일 ---
# log/ is colcon's build log; it is recreated on every build and is NOT the
# same thing as flight_logs/, which holds ArduPilot dataflash .BIN files.
build/
install/
log/

# --- Python 관련 ---
__pycache__/
*.py[cod]
*.so

# --- VS Code 설정 파일 (나만 쓰는 설정) ---
.vscode/

# --- 시뮬레이션/비행 산출물 (커밋 금지) ---
flight_logs/
gazebo/backups/
gazebo/validation/repository_runtime/
*.BIN
eeprom.bin
*.tlog
*.tlog.raw
mav.parm
dumpcore.sh_*.out
dumpstack.sh_*.out

# --- 기타 ---
.DS_Store

# 비행 로그 분석 작업 공간: pull_flightlogs 가 여기로 CSV 를 내려받는다.
# 실행 산출물이지 소스가 아니고, 실행 한 번에 메가바이트 단위로 늘어난다.
flight_logs_analysis/
