# --- ROS 2 기본 무시 파일 ---
# log/ is colcon's build log; it is recreated on every build and is NOT the
# same thing as flight_logs/, which holds ArduPilot dataflash .BIN files.
build/
install/
log/

# --- Python 관련 ---
__pycache__/
*.py[cod]
*.so

# --- VS Code 설정 파일 (나만 쓰는 설정) ---
.vscode/

# --- 시뮬레이션/비행 산출물 (커밋 금지) ---
flight_logs/
gazebo/backups/
gazebo/validation/repository_runtime/
*.BIN
eeprom.bin
*.tlog
*.tlog.raw
mav.parm
dumpcore.sh_*.out
dumpstack.sh_*.out

# --- 기타 ---
.DS_Store
