Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: world
    Background Color: 20; 25; 35
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 5
    Plane Cell Count: 30
  - Class: rviz_default_plugins/PointCloud2
    Name: Stored background
    Enabled: true
    Topic:
      Value: /jol/background
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      History Policy: Keep Last
      Depth: 5
    Size (Pixels): 3
    Size (m): 0.045
    Style: Points
    Color Transformer: FlatColor
    Color: 110; 130; 150
    Alpha: 0.8
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: MID360 raw points
    Enabled: false
    Topic:
      Value: /jol/lidar/points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Size (Pixels): 3
    Size (m): 0.045
    Style: Points
    Color Transformer: FlatColor
    Color: 220; 220; 220
    Alpha: 0.8
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: World registered live cloud
    Enabled: false
    Topic:
      Value: /jol/registered_points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Size (Pixels): 3
    Size (m): 0.045
    Style: Points
    Color Transformer: FlatColor
    Color: 90; 180; 220
    Alpha: 0.8
    Decay Time: 0
  - Class: rviz_default_plugins/PointCloud2
    Name: New object points
    Enabled: true
    Topic:
      Value: /jol/foreground
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Size (Pixels): 3
    Size (m): 0.045
    Style: Points
    Color Transformer: FlatColor
    Color: 255; 160; 40
    Alpha: 0.8
    Decay Time: 0
  - Class: rviz_default_plugins/MarkerArray
    Name: IDs boxes trails surface distance
    Enabled: true
    Topic:
      Value: /jol/markers
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Namespaces: {}
  - Class: rviz_default_plugins/MarkerArray
    Name: Camera LiDAR classification
    Enabled: true
    Topic:
      Value: /jol/fusion_markers
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Namespaces: {}
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Show Arrows: true
    Show Axes: true
    Show Names: true
    Marker Scale: 2
  - Class: rviz_default_plugins/MarkerArray
    Name: Predicted target and manipulator pointer
    Enabled: true
    Topic:
      Value: /jol/pointing/markers
      Depth: 5
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Namespaces: {}
  - Class: rviz_default_plugins/Image
    Name: D435 RGB and fused identification
    Enabled: true
    Topic:
      Value: /jol/camera/annotated
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 1
    Normalize Range: true
    Min Value: 0
    Max Value: 1
    Transport Hint: raw
  - Class: rviz_default_plugins/Path
    Name: Observer snapshot preview (not flight command)
    Enabled: false
    Topic:
      Value: /jol/observer/path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
    Buffer Length: 1
    Line Style: Lines
    Line Width: 0.04
    Color: 230; 170; 55
    Alpha: 0.9
  - Class: rviz_default_plugins/Path
    Name: Simulated observer flight plan
    Enabled: true
    Topic:
      Value: /jol/observer/flight_path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
    Buffer Length: 1
    Line Style: Lines
    Line Width: 0.06
    Color: 255; 170; 40
    Alpha: 1
  - Class: rviz_default_plugins/Path
    Name: Simulated observer actual flight
    Enabled: true
    Topic:
      Value: /jol/observer/flown_path
      Reliability Policy: Reliable
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 1
    Buffer Length: 1
    Line Style: Lines
    Line Width: 0.06
    Color: 30; 210; 170
    Alpha: 1
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 160
      Focal Point:
        X: 0
        Y: 0
        Z: 5
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: world
Window Geometry:
  Width: 1500
  Height: 950
