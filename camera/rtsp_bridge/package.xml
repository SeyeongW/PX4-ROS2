<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtsp_bridge</name>
  <version>0.1.0</version>
  <description>
    RTSP to ROS 2: decodes the SIYI A8 mini H.264 stream with GStreamer and
    publishes sensor_msgs/Image plus CameraInfo, which is what turns the gimbal
    camera into an input the ArUco perception chain can use.
  </description>
  <maintainer email="seyeong186@gmail.com">seyeongW</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-gi</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>
  <exec_depend>gstreamer1.0-libav</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
