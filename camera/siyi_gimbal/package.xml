<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>siyi_gimbal</name>
  <version>0.1.0</version>
  <description>
    SIYI A8 mini gimbal control: points the camera straight down as soon as the
    vehicle arms, and holds it there. Speaks the SIYI UDP protocol directly.
  </description>
  <maintainer email="seyeong186@gmail.com">seyeongW</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>mavros_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
