          Value: true
        down_depth_optical_frame:
          Value: true
        down_rgb_link:
          Value: true
        front_camera_optical_frame:
          Value: true
        front_depth_link:
          Value: true
        front_depth_optical_frame:
          Value: true
        front_rgb_link:
          Value: true
        lidar_sensor_link:
          Value: true
        map:
          Value: true
        map_ned:
          Value: true
        odom:
          Value: true
        odom_ned:
          Value: true
