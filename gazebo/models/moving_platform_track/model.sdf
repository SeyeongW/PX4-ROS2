<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="flat_platform">
    <link name="platform_link">
      <!-- Truck/trailer body: fills the gap between the ground and the
           landing plate so this reads as "a box with a bigger flat bed on
           top" instead of a plate floating at z=2 with nothing under it.
           Same link as the plate (rigid, moves as one unit with the
           VelocityControl plugin below). Footprint matches the 5x5 plate
           exactly, centred on the same origin; an earlier smaller/offset
           version (1.5x3.0, shifted to x=-1.75 to clear the camera) was
           fine sitting still, but under actual driving (VelocityControl
           acceleration + ground friction on the box) it tipped the whole
           platform: the huge <inertial> below is a flat round-number
           placeholder (not derived from this geometry) that implicitly
           assumes the collision mass is distributed symmetrically about the
           link origin, and any offset or undersized footprint breaks that
           assumption, giving the drive force a lever arm to rotate against.
           Matching the plate exactly removes the asymmetry regardless of how
           (in)accurate the inertia numbers are. Height (1.9) touches the
           plate's underside (world z=1.95) while stopping just short of the
           ground (world z=0.05) to avoid z-fighting/resting-contact jitter
           with ground_plane; same as moving_platform_aruco.
           This box now spans local x:[-2.5,2.5], so front_camera (below)
           had to move from x=0.60 to x=4.5; centred/undersized placements
           were tried and rejected before (see git history) because the
           camera ended up close enough to the box that its wide FOV
           (1.60 rad hfov) plus its steep down-pitch (0.61 rad) still framed
           solid box surface instead of the track; ~1.6m of clearance from
           the box edge was the empirically-found minimum that stayed clear,
           so x=4.5 (2.0m past the box's front face at x=2.5) was chosen with
           margin. track_follower_px4.yaml's cam_x must match this exactly
           (it's the camera's forward-offset-from-origin used directly in
           track_follower_node's IPM math, not just cosmetic). Don't move
           either one without re-checking a captured /front_camera/image
           frame; the failure mode is silent (no errors, just a
           solid-colour image) and would quietly break track_follower_node. -->
      <visual name="body_visual">
        <pose>0 0 -1.0 0 0 0</pose>
        <geometry>
          <box>
            <size>5 5 1.9</size>
          </box>
        </geometry>
        <material>
          <ambient>0.55 0.32 0.05 1</ambient>
          <diffuse>0.6 0.38 0.08 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 -1.0 0 0 0</pose>
        <geometry>
          <box>
            <size>5 5 1.9</size>
          </box>
        </geometry>
      </collision>
      <visual name="platform_visual">
        <geometry>
          <box>
            <size>5 5 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <!-- Same ArUco decal as moving_platform_aruco (see that model for why
           it's a second visual on this link rather than a separate model). -->
      <visual name="aruco_visual">
        <pose>0 0 0.051 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1.0 1.0</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://moving_platform_track/arucotag.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- Forward-looking camera for lane following, copied from
           gazebo/models/aruco_platform/model.sdf (same pose/FOV/topic, so
           track_follower.yaml's cam_fov/cam_height/cam_pitch/cam_x defaults
           and IPM geometry need no changes). Explicit <topic> keeps the ROS
           side simple (/front_camera/image, not an auto long gz path). -->
      <visual name="camera_housing">
        <pose>4.5 0 -1.15 0 0.61 0</pose>
        <geometry>
          <box>
            <size>0.08 0.08 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <gz_frame_id>flat_platform/front_camera</gz_frame_id>
        <!-- world-height fix: aruco_platform's camera pose (z=0.85) assumed a
             GROUND-LEVEL platform body; this platform_link's origin sits at
             world z=2 (inherited from moving_platform's aerial drop-off-table
             convention), so copying that pose verbatim put the camera at
             2.85m instead of 0.85m; confirmed visually (a captured raw
             frame showed the track receding to a vanishing point near the
             TOP of the image, with roi_top..roi_bot entirely on the flat
             ground_plane instead of the road). z=0.85-2.0=-1.15 restores the
             actual 0.85m world height track_follower.yaml's IPM geometry was
             tuned for. Leaves the camera visually detached below the platform
             body, which is fine for the vision/control loop, not for looks. -->
        <pose>4.5 0 -1.15 0 0.61 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>front_camera/image</topic>
        <camera>
          <horizontal_fov>1.60</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>1000</far>
          </clip>
          <optical_frame_id>flat_platform/front_camera_optical</optical_frame_id>
        </camera>
      </sensor>
      <collision name="platform_collision">
        <geometry>
          <box>
            <size>5 5 0.1</size>
          </box>
        </geometry>
      </collision>
      <pose>0 0 2 0 0 0</pose>
      <inertial>
          <mass>10000</mass>
          <inertia>
              <ixx>10000</ixx>
              <iyy>10000</iyy>
              <izz>10000</izz>
          </inertia>
      </inertial>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
    <!-- Driven by an external cmd_vel (track_follower_node), not
         MovingPlatformController (see moving_platform_aruco for that one). -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/flat_platform/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
