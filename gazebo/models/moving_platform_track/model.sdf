<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="flat_platform">
    <link name="platform_link">
      <visual name="body_visual">
        <pose>0 0 -1 0 0 0</pose>
        <geometry><box><size>5 5 1.9</size></box></geometry>
        <material>
          <ambient>0.55 0.32 0.05 1</ambient>
          <diffuse>0.60 0.38 0.08 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 -1 0 0 0</pose>
        <geometry><box><size>5 5 1.9</size></box></geometry>
        <surface>
          <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          <contact><ode><kp>100000</kp><kd>10</kd><max_vel>0.1</max_vel></ode></contact>
        </surface>
      </collision>

      <visual name="platform_visual">
        <geometry><box><size>5 5 0.1</size></box></geometry>
        <material>
          <ambient>0.30 0.30 0.30 1</ambient>
          <diffuse>0.36 0.36 0.36 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
      <collision name="platform_collision">
        <geometry><box><size>5 5 0.1</size></box></geometry>
      </collision>
      <visual name="aruco_visual">
        <pose>0 0 0.051 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>model://aruco_marker_0/materials/textures/aruco_0.png</albedo_map>
            <metalness>0.0</metalness><roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <!-- seo keeps the link origin 2 m above the body bottom convention. -->
      <pose>0 0 2 0 0 0</pose>
      <inertial>
        <mass>10000</mass>
        <inertia>
          <ixx>10000</ixx><iyy>10000</iyy><izz>10000</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on><update_rate>30</update_rate>
      </sensor>
    </link>
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/flat_platform/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
