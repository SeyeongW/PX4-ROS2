<?xml version="1.0"?>
<model>
  <name>moving_platform_track</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Same flat platform + ArUco decal as moving_platform_aruco, but driven by
    gz-sim's stock VelocityControl system plugin (cmd_vel topic) instead of
    PX4's MovingPlatformController, plus a forward-looking camera -- so
    track_follower_node (vision-based lane following, ported from the
    ArduPilot-era aruco_platform world) can drive it instead of the constant-
    velocity+noise default. Use moving_platform_aruco for the simple
    constant-velocity trailer; use this one for real vision track-following.
  </description>
</model>
