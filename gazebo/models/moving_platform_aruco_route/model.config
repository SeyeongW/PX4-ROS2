<?xml version="1.0"?>
<model>
  <name>moving_platform_aruco_route</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    moving_platform_aruco's 4x4m ArUco-decaled trailer, but driven by gz's own
    VelocityControl plugin (copied from moving_platform_track's pattern)
    instead of PX4's MovingPlatformController -- so moving_marker_node's
    pattern='route' (an arbitrary waypoint loop, e.g.
    gazebo/config/trailer_route_city.yaml) can drive it, which
    MovingPlatformController's constant-velocity/heading-only interface
    can't. Used by gazebo/worlds/city_map/city_map_mission.world.
  </description>
</model>
