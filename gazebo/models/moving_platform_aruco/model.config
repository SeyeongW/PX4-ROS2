<?xml version="1.0"?>
<model>
  <name>moving_platform_aruco</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    PX4's stock moving_platform (flat_platform + MovingPlatformController plugin)
    with an ArUco marker decal added to the top face, so the platform doubles as
    our trailer for vision-based precision landing. Physics/plugin unchanged from
    Tools/simulation/gz/models/moving_platform in PX4-Autopilot -- only the decal
    visual is new.
  </description>
</model>
