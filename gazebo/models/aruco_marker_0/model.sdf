<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aruco_marker_0">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <!-- Physical size: 0.8 m × 0.8 m including white border -->
            <size>0.8 0.8</size>
          </plane>
        </geometry>
        <material>
          <!-- gz-sim PBR <metal> defaults metalness=1.0 → a fully-metallic
               surface with no reflection map renders BLACK. Force non-metallic
               + rough so the albedo texture shows; ambient/diffuse keep it lit. -->
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <!-- PNG generated by gazebo/gen_aruco_model.py -->
              <albedo_map>model://aruco_marker_0/materials/textures/aruco_0.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
