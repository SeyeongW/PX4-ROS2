<?xml version="1.0"?>
<sdf version="1.9">
  <!-- ================================================================== -->
  <!-- skid_rover : a REAL ArduPilot Rover (skid-steer) ground vehicle.     -->
  <!--                                                                      -->
  <!-- Replaces the firmware-less aruco_platform (a kinematic box driven by -->
  <!-- VelocityControl/cmd_vel). Here an ArduRover SITL flies the vehicle   -->
  <!-- through the ArduPilotPlugin: SITL reads the IMU and writes servo PWM,-->
  <!-- the plugin turns those PWM into wheel-joint velocities. Steering is   -->
  <!-- SKID (differential): left wheels on one throttle channel, right on    -->
  <!-- the other, so a speed difference yaws the rover (no steering hinge).  -->
  <!--                                                                      -->
  <!-- Run alongside the drone with a SECOND SITL instance on -I1, which     -->
  <!-- offsets the FDM port to 9012 (drone stays on 9002):                   -->
  <!--   sim_vehicle.py -v Rover -f JSON (frame rover-skid) -I1 (console)     -->
  <!-- ArduPilot params for skid steering:                                   -->
  <!--   SERVO1_FUNCTION 73  (ThrottleLeft)   -> plugin channel 0            -->
  <!--   SERVO3_FUNCTION 74  (ThrottleRight)  -> plugin channel 2            -->
  <!--                                                                      -->
  <!-- Geometry (origin at chassis centre, ground at z=0):                   -->
  <!--   wheel radius 0.15 -> wheel axles at z=0.15 touch the ground         -->
  <!--   chassis box 1.0(x) x 0.7(y) x 0.16(z), centre z=0.20 -> top z=0.28  -->
  <!--   wheels at y=+/-0.42 (wide track) + low COM so it cannot flip when   -->
  <!--   driven hard; ArUco marker / drone landing surface = top, z=0.28     -->
  <!-- ================================================================== -->
  <model name="skid_rover">
    <!-- ============================================================== -->
    <!-- Chassis (flatbed): the driven body + landing surface on top.    -->
    <!-- ============================================================== -->
    <link name="chassis">
      <pose>0 0 0.20 0 0 0</pose>
      <inertial>
        <mass>12.0</mass>
        <inertia>
          <ixx>0.52</ixx><iyy>1.03</iyy><izz>1.49</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_col">
        <geometry><box><size>1.0 0.7 0.16</size></box></geometry>
      </collision>
      <visual name="chassis_vis">
        <geometry><box><size>1.0 0.7 0.16</size></box></geometry>
        <material>
          <ambient>0.25 0.28 0.32 1</ambient>
          <diffuse>0.30 0.34 0.40 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- ArUco marker on the flatbed top (z=0.35, marker just above to avoid
           z-fighting). Same non-metallic albedo trick as aruco_marker_0 so the
           PNG shows. This is the drone's precision-landing target. -->
      <visual name="marker_vis">
        <pose>0 0 0.081 0 0 0</pose>
        <geometry>
          <plane><normal>0 0 1</normal><size>0.5 0.5</size></plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aruco_marker_0/materials/textures/aruco_0.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Forward-looking camera for TRACK-LINE following (reused from the old
           aruco_platform). Mounted at the front-top, pitched ~35 deg down so the
           optical +X axis looks forward-and-down at the white guide line. Rides
           with the chassis so it always points along the rover's +x heading. -->
      <visual name="front_cam_vis">
        <pose>0.45 0 0.12 0 0.61 0</pose>
        <geometry><box><size>0.05 0.08 0.05</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <gz_frame_id>skid_rover/front_camera</gz_frame_id>
        <pose>0.45 0 0.12 0 0.61 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>front_camera/image</topic>
        <camera>
          <horizontal_fov>1.60</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>1000</far></clip>
          <optical_frame_id>skid_rover/front_camera_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <!-- ============================================================== -->
    <!-- IMU link : ArduPilotPlugin reads this to fly the vehicle.       -->
    <!-- Rigidly fixed to the chassis at its centre.                     -->
    <!-- ============================================================== -->
    <link name="imu_link">
      <pose>0 0 0.20 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
        <imu>
          <enable_orientation>0</enable_orientation>
        </imu>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>chassis</parent>
      <child>imu_link</child>
    </joint>

    <!-- ============================================================== -->
    <!-- Four wheels. revolute about Y (chassis forward = +x).           -->
    <!-- Left pair driven by plugin channel 0 (ThrottleLeft),            -->
    <!-- right pair by channel 2 (ThrottleRight).                        -->
    <!-- Wheel centres at z=0.15 (= radius) so they touch the ground.    -->
    <!-- ============================================================== -->
    <!-- left front -->
    <link name="wheel_lf">
      <pose>0.35 0.42 0.15 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_lf_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_lf</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><friction>0.0</friction></dynamics></axis>
    </joint>

    <!-- left rear -->
    <link name="wheel_lr">
      <pose>-0.35 0.42 0.15 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_lr_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_lr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><friction>0.0</friction></dynamics></axis>
    </joint>

    <!-- right front -->
    <link name="wheel_rf">
      <pose>0.35 -0.42 0.15 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_rf_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_rf</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><friction>0.0</friction></dynamics></axis>
    </joint>

    <!-- right rear -->
    <link name="wheel_rr">
      <pose>-0.35 -0.42 0.15 -1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.003</ixx><iyy>0.003</iyy><izz>0.005</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="col">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="vis">
        <geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_rr_joint" type="revolute">
      <parent>chassis</parent>
      <child>wheel_rr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><friction>0.0</friction></dynamics></axis>
    </joint>

    <!-- ============================================================== -->
    <!-- Plugins                                                         -->
    <!-- ============================================================== -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <!-- Port settings. -I1 offsets the FDM port to 9012 (drone keeps 9002),
           so the two SITL instances never collide on one Gazebo server. -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9012</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>

      <!-- Frame conventions: gazebo XYZ (x fwd, z up) -> ArduPilot NED. -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

      <imuName>imu_link::imu_sensor</imuName>

      <!-- Skid steering: throttle is REVERSIBLE, so PWM 1500 = stop. Map the
           1100..1900 servo band to wheel velocity -10..+10 rad/s (radius 0.15 ->
           ~1.5 m/s top speed) symmetric about 0 via offset = -multiplier/2.
           cmd_max=8 caps the per-wheel torque so the 4-wheel reaction cannot
           wheelie/flip the chassis (4*8 < m*g*wheelbase/2). Left pair = channel 0
           (ThrottleLeft), right pair = channel 2 (ThrottleRight). -->
      <!-- left front -->
      <control channel="0">
        <jointName>wheel_lf_joint</jointName>
        <useForce>1</useForce>
        <multiplier>20</multiplier>
        <offset>-10</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.8</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>8</cmd_max><cmd_min>-8</cmd_min>
      </control>
      <!-- left rear -->
      <control channel="0">
        <jointName>wheel_lr_joint</jointName>
        <useForce>1</useForce>
        <multiplier>20</multiplier>
        <offset>-10</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.8</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>8</cmd_max><cmd_min>-8</cmd_min>
      </control>
      <!-- right front -->
      <control channel="2">
        <jointName>wheel_rf_joint</jointName>
        <useForce>1</useForce>
        <multiplier>20</multiplier>
        <offset>-10</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.8</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>8</cmd_max><cmd_min>-8</cmd_min>
      </control>
      <!-- right rear -->
      <control channel="2">
        <jointName>wheel_rr_joint</jointName>
        <useForce>1</useForce>
        <multiplier>20</multiplier>
        <offset>-10</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.8</p_gain><i_gain>0</i_gain><d_gain>0</d_gain>
        <i_max>0</i_max><i_min>0</i_min>
        <cmd_max>8</cmd_max><cmd_min>-8</cmd_min>
      </control>
    </plugin>
  </model>
</sdf>
