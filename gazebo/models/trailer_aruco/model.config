<?xml version="1.0"?>
<model>
  <name>trailer_aruco</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>PX4-ROS2 contributors</name>
  </author>
  <description>
    Velocity-controlled 5.5 x 3 m landing trailer with a rigid 1 m ArUco
    marker. The companion trailer_motion_node publishes ROS odometry and TF.
  </description>
</model>
