<?xml version="1.0"?>
<model>
  <name>trailer_aruco</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>PX4-ROS2 contributors</name>
  </author>
  <description>
    Repository-owned 5.5 x 3 m landing trailer with a rigid 1 m ArUco marker.
    The active city profile spawns this model at ENU (-587, -512, 0) and keeps
    it stationary; it has no dependency on the retired autonomy planner.
  </description>
</model>
