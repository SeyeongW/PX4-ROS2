<?xml version="1.0"?>
<sdf version="1.9">
  <model name="ugv_mou_terrain">
    <static>true</static>
    <link name="terrain_link">
      <collision name="terrain_collision">
        <geometry>
          <mesh>
            <uri>model://ugv_mou_terrain/meshes/ugv_mou_terrain_collision.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.95</mu><mu2>0.95</mu2></ode></friction>
          <contact><ode><kp>1000000</kp><kd>1</kd><max_vel>0.2</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="terrain_visual">
        <cast_shadows>true</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://ugv_mou_terrain/meshes/ugv_mou_terrain_visual.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
