<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="precision_landing_200m">
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8066</gravity>

    <scene>
      <ambient>0.58 0.60 0.62 1</ambient>
      <background>0.62 0.75 0.88 1</background>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
      <sky/>
    </scene>

    <light type="directional" name="sun">
      <pose>100 100 300 0 0 0</pose>
      <diffuse>0.90 0.88 0.82 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>Precision Landing 200 m Experiment</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.58 0.60 0.62</ambient_light>
        <background_color>0.62 0.75 0.88</background_color>
        <camera_pose>20 20 18 0 0.75 0.785398</camera_pose>
        <camera_clip><near>0.2</near><far>1000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="WorldControl" name="World control">
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>true</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <sim_time>true</sim_time>
        <real_time_factor>true</real_time_factor>
      </plugin>
    </gui>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>37.32977431415926</latitude_deg>
      <longitude_deg>-121.99860517699835</longitude_deg>
      <elevation>50.6</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Exact 200 x 200 m ENU area: x=[0,200], y=[0,200], top z=0. -->
    <model name="experiment_ground">
      <static>true</static>
      <pose>100 100 0 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>200 200 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>200 200 0.1</size></box></geometry>
          <material>
            <ambient>0.30 0.34 0.30 1</ambient>
            <diffuse>0.42 0.46 0.42 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="map_boundary">
      <static>true</static>
      <link name="boundary">
        <visual name="south"><pose>100 0 0.006 0 0 0</pose><geometry><box><size>200 0.20 0.012</size></box></geometry><material><ambient>1 0.82 0.05 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
        <visual name="north"><pose>100 200 0.006 0 0 0</pose><geometry><box><size>200 0.20 0.012</size></box></geometry><material><ambient>1 0.82 0.05 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
        <visual name="west"><pose>0 100 0.006 0 0 0</pose><geometry><box><size>0.20 200 0.012</size></box></geometry><material><ambient>1 0.82 0.05 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
        <visual name="east"><pose>200 100 0.006 0 0 0</pose><geometry><box><size>0.20 200 0.012</size></box></geometry><material><ambient>1 0.82 0.05 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <frame name="drone_spawn"><pose>30 30 0 0 0 0</pose></frame>
    <frame name="trailer_spawn"><pose>37.071067811865476 37.071067811865476 0 0 0 0</pose></frame>

    <!-- Use the same measured-odometry trailer as the moving experiment, but
         do not start its external waypoint driver.  It therefore remains at
         zero velocity while still publishing /model/trailer/odometry at
         50 Hz; the landing node sees a measured stationary target instead of
         receiving a hard-coded pose. -->
    <include>
      <uri>model://moving_platform_aruco_velocity</uri>
      <name>trailer</name>
      <pose>37.071067811865476 37.071067811865476 0 0 0 0</pose>
    </include>

    <!-- PX4 SITL dynamically creates x500_city_rgbd_lidar at (30,30,0). -->
  </world>
</sdf>
