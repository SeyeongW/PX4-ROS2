<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>precision_landing</name>
  <version>0.0.0</version>
  <description>PX4/MAVROS ArUco landing with fail-closed descent and confirmed touchdown.</description>
  <maintainer email="seyeong186@gmail.com">seyeong</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mavros_msgs</depend>
  <depend>python3-numpy</depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>camera_detection</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
