#!/usr/bin/env bash
# Watch the mission from the ground station: the virtual obstacle field, the
# route it planned, and the track it actually flew.
#
#   jetson        # the shell that can see the aircraft (or `sitl`)
#   ./run_viz
#
# THIS RUNS ON THE PC, NOT ON THE JETSON. The Jetson publishes; this subscribes.
# Putting a 3D viewer on the flight computer would take cores from the detector,
# which is the one process on that machine that cannot be late — and the whole
# reason the DDS profile in config/jetson_dds_fastdds.sh exists is so the ground
# station can watch without being on board.
#
# Nothing from this repo needs to be BUILT here: every topic it draws is a
# standard message type, so the .rviz file next to this script is the only
# repo file involved.
#
# Everything drawn here comes from the mission node's own /mission/* topics and
# the TF chain landing_tf_node publishes, so this needs no simulator and no
# second copy of the map. Start it before or after the flight — the obstacles
# and the route are latched.
#
# THE ENVIRONMENT IS NOT CHANGED FOR YOU, on purpose. Watching the Jetson needs
# the discovery-server profile (`jetson`), watching SITL needs plain multicast
# (`sitl`), and discovery-server mode has no multicast fallback — so a script
# that picked one would silently show an empty screen to whoever wanted the
# other. Be in the shell you would run `ros2 topic list` from.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG="$SCRIPT_DIR/rviz/cju_mission.rviz"

# Deliberately NOT sourcing flight_env.sh as a fallback: that file is the
# JETSON's environment (its workspace overlay and its discovery-server profile),
# and quietly applying it here would be this script choosing a DDS mode two
# paragraphs after promising not to.
if ! command -v ros2 >/dev/null 2>&1; then
  echo "run_viz: no ros2 on PATH — source /opt/ros/humble/setup.bash first" >&2
  exit 1
fi
if ! command -v rviz2 >/dev/null 2>&1; then
  echo "run_viz: rviz2 is not on PATH — sudo apt install ros-humble-rviz2" >&2
  exit 1
fi

echo "run_viz: RMW=${RMW_IMPLEMENTATION:-default} DOMAIN=${ROS_DOMAIN_ID:-0}" \
     "SERVER=${ROS_DISCOVERY_SERVER:-<multicast>}"
echo "run_viz: if the screen stays empty, that line is the first thing to check"
exec rviz2 -d "$CONFIG"
