#!/usr/bin/env bash
# One command to bring up the real-flight stack on the Jetson: MAVROS on the
# PX4 USB link, then the perception + mission launch. Everything the operator
# needs is started here; the one thing left to a second terminal is the
# approval, because arming is a human decision.
#
#   ./run_px4                 ArUco precision landing  (aruco_landing.launch.py)
#   ./run_px4 trailer         the final real-aircraft mission, on ONE approval:
#                             arm -> planned route to the fixed CJU (50,50)
#                             goal -> return to the trailer radioed over
#                             900 MHz -> proven ArUco P descent.
#   ./run_px4 mpc             MPC precision landing     (fixed_marker_landing)
#   ./run_px4 naive           just MAVROS + the naive takeoff/land (no camera)
#   ./run_px4 bench           GROUND REHEARSAL of the MPC mission's SEARCH:
#                             the gimbal sweep and the marker fixes it produces,
#                             with the FCU never commanded. Props off.
#
#   FCU_URL=/dev/ttyACM0:57600 ./run_px4      override the flight-controller link
#   TRAILER_DEV=/dev/ttyUSB1 ./run_px4 trailer   the radio, if it is not USB0
#   TRAILER_LINK=0 ./run_px4 trailer          you are running trailer_gps_node
#                                             yourself; do not start a second
#   ROUTE_MAP_APPROVED=1 ./run_px4 trailer    explicit field-map approval;
#                                             never set this for an unmeasured map
#   EXPERIMENT_LOG_DIR=... ./run_px4 trailer  CSV output directory (default:
#                                             ~/px4_experiment_logs)
#   GNSS_CHECK=on ./run_px4 mpc               put the GNSS preflight gate back
#   GATES=all ./run_px4 mpc                   approve takeoff and search too,
#                                             not just the arm (mpc only)
#
# Approve / abort from another terminal (under launch, ENTER does not reach the
# node — see the launch docstrings):
#
#   ros2 run mpc_landing approve aruco_landing_node
#   ros2 run mpc_landing abort   aruco_landing_node
#
# Ctrl-C stops everything it started.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODE="${1:-aruco}"

case "$MODE" in
  aruco) MISSION_LAUNCH="aruco_landing.launch.py";        NODE="aruco_landing_node" ;;
  # The one final trailer stack: proven GPS and ArUco P landing around Wang's
  # obstacle-aware geometry and TrackingMPC cruise. Approve the arm and the
  # whole thing — route, goal, return, search, descent — runs on its own.
  trailer) MISSION_LAUNCH="aruco_landing.launch.py";      NODE="aruco_landing_node"
         TRAILER=1 ;;
  mpc)   MISSION_LAUNCH="fixed_marker_landing.launch.py"; NODE="mpc_landing_node" ;;
  naive) MISSION_LAUNCH="";                               NODE="naive_flight_node" ;;
  # The mpc stack exactly, with the mission node started in SEARCH and forbidden
  # to touch the flight controller (see bench_search in mpc_landing_node). Same
  # camera, same detector, same gimbal, same geometry — the only thing missing
  # is the flying, which is the point.
  bench) MISSION_LAUNCH="fixed_marker_landing.launch.py"; NODE="mpc_landing_node"
         BENCH=1 ;;
  -h|--help|help)
    sed -n '2,/^set -Eeuo pipefail$/p' "${BASH_SOURCE[0]}" \
      | sed '$d; s/^# \{0,1\}//'
    exit 0 ;;
  *) echo "unknown mode '$MODE' (try: aruco | trailer | mpc | naive | bench)" >&2
     exit 2 ;;
esac
BENCH="${BENCH:-0}"
TRAILER="${TRAILER:-0}"
# The B end of the 900 MHz pair, on the Jetson. SiK radios enumerate as ttyUSB.
TRAILER_DEV="${TRAILER_DEV:-/dev/ttyUSB0}"
TRAILER_BAUD="${TRAILER_BAUD:-57600}"
# Source-tree map by design: run_px4 itself is a source-tree operator script.
# Default to the drone-relative obstacle field: it is centred on wherever the
# drone launches (map origin = the vehicle's own local ENU origin) and carries a
# virtual barrier field to weave through for the avoidance demo. The barriers
# are virtual (a simulated collision breaks nothing), so it is hardware-flight-
# approved by construction — plain `run_px4 trailer` needs no ROUTE_MAP_APPROVED
# override. Select the surveyed CJU layout with
# `ROUTE_MAP=$SCRIPT_DIR/../path_plan/config/drone_cju_route.yaml run_px4 trailer`.
ROUTE_MAP="${ROUTE_MAP:-$SCRIPT_DIR/../path_plan/config/drone_field_route.yaml}"
# Maximum source-time skew when pairing the vehicle's local and global poses.
ROUTE_SYNC_S="${ROUTE_SYNC_S:-0.10}"
if [[ "$TRAILER" == "1" && ! -r "$ROUTE_MAP" ]]; then
  echo "run_px4: route map is not readable: $ROUTE_MAP" >&2
  exit 1
fi

# The flight-controller link. ttyACM is USB CDC (baud is ignored, but MAVROS
# still wants a number); change the device for a TELEM UART, e.g.
# FCU_URL=/dev/ttyTHS1:921600.
FCU_URL="${FCU_URL:-/dev/ttyACM0:57600}"
# PX4 uses OFFBOARD, so the PX4 MAVROS config. ArduPilot would be apm.launch.
MAVROS_LAUNCH="${MAVROS_LAUNCH:-px4.launch}"

# --- the GNSS preflight gate is OFF here, on purpose ------------------------
# The mission node's 'EKF position aiding' check refuses to prompt for an arm
# while the EKF has no GNSS aiding. On the pad it does not measure what it
# claims to: when it blocks, arming once from the RC in POSITION mode and
# disarming again makes it PASS — the vehicle is no more aided than it was a
# minute earlier, the check simply saw a different moment. A gate whose verdict
# can be flipped by an unrelated action is not a safety check; it is a delay
# that teaches the operator to work around it, and working around a preflight
# is the habit that must not be trained.
#
# What is NOT lost by turning it off: PX4 still refuses to arm without its own
# EKF/GNSS conditions, and that refusal is the authoritative one. What IS lost:
# the early, readable explanation of WHY PX4 will refuse. So the node keeps
# reporting the EKF state — it just no longer holds the mission on it.
#
# GNSS_CHECK=on restores the gate for a flight where you want it.
GNSS_CHECK="${GNSS_CHECK:-off}"
MISSION_ARGS=()
if [[ "$GNSS_CHECK" == "on" ]]; then
  echo "run_px4: GNSS preflight gate ENABLED (GNSS_CHECK=on)"
else
  MISSION_ARGS+=(--ros-args -p require_gnss_aiding:=false)
fi
# The bench rehearses SEARCH and nothing else: the node starts there and is
# barred from commanding the FCU. --ros-args may appear only once, so this
# reuses the block above rather than opening a second one.
if [[ "$BENCH" == "1" ]]; then
  [[ ${#MISSION_ARGS[@]} -gt 0 ]] || MISSION_ARGS+=(--ros-args)
  MISSION_ARGS+=(-p bench_search:=true)
fi
# The mission node is started by THIS script, not by the launch (so ENTER can
# approve it), which is why the launch's trailer:= argument cannot configure it
# — the planned route has to be switched on here as well as the nodes there.
if [[ "$TRAILER" == "1" ]]; then
  [[ ${#MISSION_ARGS[@]} -gt 0 ]] || MISSION_ARGS+=(--ros-args)
  MISSION_ARGS+=(-p cruise_to_trailer:=true
                 -p planned_cruise:=true
                 -p "route_map_yaml:=$ROUTE_MAP"
                 -p "route_pose_fix_sync_s:=$ROUTE_SYNC_S"
                 -p rate_hz:=50.0)
  # The approval gate only bites a map whose YAML sets hardware_flight_approved
  # false (the surveyed CJU map). The default drone-relative field map is
  # approved in its YAML, so plain `run_px4 trailer` sails through with no
  # override. ROUTE_MAP_APPROVED=1 stays as the escape hatch for flying an
  # unapproved map (e.g. the CJU layout before it is field-surveyed).
  if [[ "${ROUTE_MAP_APPROVED:-0}" == "1" ]]; then
    MISSION_ARGS+=(-p allow_unapproved_route_map:=true)
    echo "run_px4: ROUTE MAP APPROVAL OVERRIDE ACTIVE"
    echo "         operator asserts origin, heading and every obstacle were checked"
  else
    echo "run_px4: using route map $ROUTE_MAP"
    echo "         (an unapproved map still needs ROUTE_MAP_APPROVED=1)"
  fi
fi
# --- legacy mpc_landing_node gates ------------------------------------------
# mpc_landing_node stops again after arming
# and again at altitude, which means an armed airframe sitting on the pad with
# live props waiting for a keystroke — the state you least want to extend. This
# option belongs only to the standalone mpc_landing_node modes.
#
# The ARM approval is NOT affected and cannot be: mission.AUTO_RELEASABLE does
# not contain it. `abort` still lands the vehicle from any phase.
# GATES=all restores the three-gate behaviour for a flight that wants it.
GATES="${GATES:-arm}"
if [[ "$NODE" == "mpc_landing_node" && "$BENCH" != "1" ]]; then
  if [[ "$GATES" == "all" ]]; then
    echo "run_px4: all three approval gates ENABLED (GATES=all)"
  else
    [[ ${#MISSION_ARGS[@]} -gt 0 ]] || MISSION_ARGS+=(--ros-args)
    MISSION_ARGS+=(-p auto_after_arm:=true)
  fi
fi
# The environment is normally already set by .bashrc; source it ourselves only
# if it is not, so this also works from cron/systemd (see flight_env.sh).
if ! command -v ros2 >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/flight_env.sh"
fi

PIDS=()
cleanup() {
  trap - EXIT INT TERM
  echo
  echo "run_px4: stopping the stack..."
  for pid in "${PIDS[@]:-}"; do kill "$pid" 2>/dev/null || true; done
  # Sweep the nodes ros2 launch/run spawned in their own process groups, so a
  # detached child cannot survive and break the next run.
  # Only ever sweep what THIS script started. With TRAILER_LINK=0 the radio
  # reader belongs to the operator's own terminal, and killing it on Ctrl-C
  # would take down the thing they are watching.
  RADIO_PAT="trailer_gps_node"
  if [[ "${TRAILER_LINK:-1}" == "0" ]]; then
    RADIO_PAT=""
  fi
  for pat in mavros_node aruco_landing_node mpc_landing_node naive_flight_node \
             aruco_pose_node gst_camera_node siyi_gimbal_node landing_tf_node \
             trailer_target_node experiment_logger ${RADIO_PAT}; do
    pkill -TERM -f "$pat" 2>/dev/null || true
  done
  sleep 1
  for pat in mavros_node aruco_pose_node gst_camera_node siyi_gimbal_node \
             landing_tf_node trailer_target_node ${RADIO_PAT}; do
    pkill -KILL -f "$pat" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap cleanup EXIT INT TERM

if [[ ! -e "${FCU_URL%%:*}" ]]; then
  echo "run_px4: WARNING — ${FCU_URL%%:*} does not exist. Is the FCU plugged in?" >&2
  echo "         (ls /dev/ttyACM* ; override with FCU_URL=...)" >&2
fi

# --- MAVROS -----------------------------------------------------------------
echo "run_px4: starting MAVROS on $FCU_URL ($MAVROS_LAUNCH)"
ros2 launch mavros "$MAVROS_LAUNCH" fcu_url:="$FCU_URL" \
  >/tmp/run_px4_mavros.log 2>&1 &
PIDS+=($!)

# Wait for the link before starting the mission: the mission node's preflight
# blocks on /mavros/state anyway, but waiting here gives one clear message
# instead of a wall of "no FCU link" warnings.
echo -n "run_px4: waiting for /mavros/state (link to the FCU)"
linked=0
for _ in $(seq 1 40); do
  if timeout 2 ros2 topic echo /mavros/state --once >/dev/null 2>&1; then
    linked=1; echo " — up"; break
  fi
  echo -n "."; sleep 1
  if ! kill -0 "${PIDS[-1]}" 2>/dev/null; then
    echo; echo "run_px4: MAVROS exited — see /tmp/run_px4_mavros.log" >&2; exit 1
  fi
done
if [[ "$linked" -eq 0 ]]; then
  echo; echo "run_px4: no /mavros/state after 40 s — check the cable, the" >&2
  echo "         FCU_URL device, and /tmp/run_px4_mavros.log" >&2
fi

# --- perception (background) + mission (foreground, so ENTER approves) ------
# The mission node runs in the FOREGROUND under `ros2 run`, not under
# `ros2 launch`, so it inherits this terminal's stdin and its ENTER-to-approve
# prompt works. The perception stack (camera + detector + gimbal + tf) goes to
# the background via the launch with mission:=false. NOT `exec`, so the cleanup
# trap still fires on Ctrl-C and takes MAVROS and the perception nodes with it.
LAUNCH_ARGS=(mission:=false)
if [[ "$TRAILER" == "1" ]]; then
  if [[ ! -e "$TRAILER_DEV" ]]; then
    echo "run_px4: WARNING — $TRAILER_DEV does not exist. Is the 900 MHz radio" >&2
    echo "         plugged in? (ls /dev/ttyUSB* ; override with TRAILER_DEV=...)" >&2
  fi
  LAUNCH_ARGS+=(trailer:=true "trailer_device:=$TRAILER_DEV"
                "trailer_baud:=$TRAILER_BAUD"
                "trailer_input_sync_s:=$ROUTE_SYNC_S")
  # TRAILER_LINK=0: the operator is already running trailer_gps_node in their
  # own terminal, so do not start a second one. One serial port, one reader —
  # the loser of that race fails quietly into a log file.
  if [[ "${TRAILER_LINK:-1}" == "0" ]]; then
    LAUNCH_ARGS+=(trailer_radio:=false)
    echo "run_px4: NOT starting trailer_gps_node (TRAILER_LINK=0) — expecting"
    echo "         /trailer/fix from the one you are running yourself"
  fi
fi

if [[ -n "$MISSION_LAUNCH" ]]; then
  echo "run_px4: starting $MISSION_LAUNCH perception (camera + detector + gimbal + tf)"
  # `set -e` is on: a bare `[[ ... ]] && echo` would exit the script whenever the
  # test is false, so every conditional here is a real `if`.
  SETTLE=2
  if [[ "$TRAILER" == "1" ]]; then
    echo "run_px4: + trailer link on $TRAILER_DEV @ $TRAILER_BAUD -> /trailer/target_local"
    # The trailer target has a whole radio chain behind it and the mission
    # refuses to offer the arm without one, so give it longer than the detector.
    SETTLE=5
  fi
  ros2 launch mpc_landing "$MISSION_LAUNCH" "${LAUNCH_ARGS[@]}" \
    >/tmp/run_px4_stack.log 2>&1 &
  PIDS+=($!)
  sleep "$SETTLE"   # let the stack advertise before the node's preflight looks
fi

# Observation only: failure or absence of the logger never gates flight.
if [[ "$TRAILER" == "1" ]]; then
  LOGGER_ARGS=(--ros-args -p "map_yaml:=$ROUTE_MAP"
               -p "pose_fix_sync_tolerance_s:=$ROUTE_SYNC_S")
  if [[ -n "${EXPERIMENT_LOG_DIR:-}" ]]; then
    LOGGER_ARGS+=(-p "output_dir:=$EXPERIMENT_LOG_DIR")
  fi
  ros2 run path_plan experiment_logger "${LOGGER_ARGS[@]}" \
    >/tmp/run_px4_experiment_logger.log 2>&1 &
  LOGGER_PID=$!
  PIDS+=("$LOGGER_PID")
  sleep 0.2
  if kill -0 "$LOGGER_PID" 2>/dev/null; then
    echo "run_px4: experiment logger started (default CSV dir: ~/px4_experiment_logs)"
  else
    echo "run_px4: WARNING: experiment logger failed; see /tmp/run_px4_experiment_logger.log" >&2
  fi
fi

echo
if [[ "$BENCH" == "1" ]]; then
  echo "run_px4: starting $NODE in BENCH SEARCH — no arm, no setpoint, no gate."
  echo "         The GIMBAL WILL MOVE. Props off. Ctrl-C stops everything."
else
  echo "run_px4: starting $NODE — approve HERE by pressing ENTER (n aborts),"
  echo "         or from another terminal: ros2 run mpc_landing approve $NODE"
  if [[ "$TRAILER" == "1" ]]; then
    echo "         ONE approval: arm -> CJU route -> trailer return -> descent"
  fi
  if [[ "$GNSS_CHECK" != "on" ]]; then
    echo "         GNSS preflight gate is OFF — PX4's own arm check still applies."
  fi
fi
echo
ros2 run mpc_landing "$NODE" "${MISSION_ARGS[@]}"
