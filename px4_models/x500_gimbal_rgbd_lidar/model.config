<?xml version="1.0"?>
<model>
  <name>x500_gimbal_rgbd_lidar</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>seyeongW</name>
    <email>seyeong186@gmail.com</email>
  </author>
  <description>
    x500_city_rgbd_lidar plus a 3-axis gimbal camera slung under the airframe.
    A strict superset of the baseline vehicle: every existing sensor topic is
    unchanged, so a run can be compared body-fixed vs gimbal-stabilised by
    switching only the vehicle.
  </description>
</model>
