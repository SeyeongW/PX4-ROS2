<?xml version="1.0"?>
<model>
  <name>gimbal_down</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>seyeongW</name>
    <email>seyeong186@gmail.com</email>
  </author>
  <description>
    Down-looking 3-axis camera gimbal, derived from PX4-Autopilot
    Tools/simulation/gz/models/gimbal (Stefano Colli, Auterion).  Same links,
    joints, meshes and JointPositionController plugins, so it accepts the same
    /model/&lt;entity&gt;/command/gimbal_{roll,pitch,yaw} commands as PX4's own
    x500_gimbal.  Differences from upstream: payload camera resized for ArUco
    (1.6 rad hfov, 800x600, 25 Hz, 200 m clip) on named topics, camera
    collision sphere removed because this gimbal hangs below the airframe,
    and link masses halved to 0.05 kg so the pod costs 0.2 kg instead of 0.4.
    Meshes are still loaded from model://gimbal, so PX4-Autopilot must be on
    GZ_SIM_RESOURCE_PATH.
  </description>
</model>
