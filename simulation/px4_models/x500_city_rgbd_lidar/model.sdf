<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_city_rgbd_lidar">
    <self_collide>false</self_collide>

    <!-- Keep the PX4 airframe unchanged.  The perception payload below uses
         unique links, sensor names, Gazebo topics and frame IDs so a bridge
         can never confuse the front and down cameras. -->
    <include merge="true">
      <uri>x500</uri>
    </include>

    <!-- Forward RGB camera: long-range scene / marker verification.
         Gazebo cameras look along local +X. Keep this camera horizontal;
         downward perception is handled by the dedicated down camera. -->
    <link name="front_rgb_link">
      <!-- Keep the housing attached to the X500 centre plate.  The useful
           forward view comes from the horizontal optical axis; raising this
           relative z to 0.242 makes the box appear detached above the body. -->
      <pose relative_to="base_link">0.12 0.03 0.002 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00003</ixx><iyy>0.00003</iyy><izz>0.00003</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="front_rgb_visual">
        <geometry><box><size>0.035 0.09 0.03</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <sensor name="front_rgb_camera" type="camera">
        <gz_frame_id>front_rgb_link</gz_frame_id>
        <topic>front_camera/image</topic>
        <camera>
          <camera_info_topic>front_camera/camera_info</camera_info_topic>
          <optical_frame_id>front_camera_optical_frame</optical_frame_id>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>360</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>120.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="front_rgb_joint" type="fixed">
      <parent>base_link</parent><child>front_rgb_link</child>
    </joint>

    <!-- Forward depth camera: unregistered obstacle detection.  Naming the
         native image /front_depth/image also makes gz-sensors publish its
         CameraInfo at /front_depth/camera_info (instead of global /camera_info). -->
    <link name="front_depth_link">
      <pose relative_to="base_link">0.12 0.00 0.002 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="front_depth_camera" type="depth_camera">
        <gz_frame_id>front_depth_link</gz_frame_id>
        <topic>front_depth/image</topic>
        <camera>
          <camera_info_topic>front_depth/camera_info</camera_info_topic>
          <optical_frame_id>front_depth_optical_frame</optical_frame_id>
          <horizontal_fov>1.274</horizontal_fov>
          <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
          <clip><near>0.20</near><far>30.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>12</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="front_depth_joint" type="fixed">
      <parent>base_link</parent><child>front_depth_link</child>
    </joint>

    <!-- Down RGB camera: calibrated ArUco terminal tracking.  +90 deg pitch
         rotates the camera's local +X viewing ray onto body -Z. -->
    <link name="down_rgb_link">
      <pose relative_to="base_link">0 0 -0.05 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.04</mass>
        <inertia>
          <ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="down_rgb_visual">
        <geometry><box><size>0.02 0.04 0.04</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <sensor name="down_rgb_camera" type="camera">
        <gz_frame_id>down_rgb_link</gz_frame_id>
        <topic>down_camera/image</topic>
        <camera>
          <camera_info_topic>down_camera/camera_info</camera_info_topic>
          <optical_frame_id>down_camera_optical_frame</optical_frame_id>
          <horizontal_fov>1.396</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>80.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="down_rgb_joint" type="fixed">
      <parent>base_link</parent><child>down_rgb_link</child>
    </joint>

    <!-- A real downward depth camera, not a monocular-range approximation. -->
    <link name="down_depth_link">
      <pose relative_to="base_link">0 -0.03 -0.05 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="down_depth_visual">
        <geometry><box><size>0.02 0.04 0.04</size></box></geometry>
        <material><ambient>0.05 0.05 0.15 1</ambient><diffuse>0.08 0.08 0.25 1</diffuse></material>
      </visual>
      <sensor name="down_depth_camera" type="depth_camera">
        <gz_frame_id>down_depth_link</gz_frame_id>
        <topic>down_depth/image</topic>
        <camera>
          <camera_info_topic>down_depth/camera_info</camera_info_topic>
          <optical_frame_id>down_depth_optical_frame</optical_frame_id>
          <horizontal_fov>1.274</horizontal_fov>
          <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
          <clip><near>0.15</near><far>80.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="down_depth_joint" type="fixed">
      <parent>base_link</parent><child>down_depth_link</child>
    </joint>
  </model>
</sdf>
