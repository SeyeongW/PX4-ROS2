<?xml version="1.0"?>
<model>
  <name>gimbal_classic</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <author>
    <name>seyeongW</name>
    <email>seyeong186@gmail.com</email>
  </author>
  <description>
    Gazebo Classic port of the PX4 CGO3 3-axis gimbal camera. Same geometry,
    joint limits and PID gains as ../gimbal (gz-sim); gz systems replaced by
    gazebo_ros sensor plugins plus the joint position controller in ../../plugins.
    Meshes are shared with ../gimbal rather than duplicated.
  </description>
</model>
