<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="Simple_15m_Rover_Bird_Runway">
    <!-- Gazebo Sim / Harmonic systems. ROS topics can be exposed through
         ros_gz_bridge; the Gazebo Classic libgazebo_ros_state plugin from the
         source world cannot be loaded by gz-sim. -->
    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://bird</uri>
      <name>bird_1</name>
      <pose>4.0 4.0 3.2 0 0 0</pose>
    </include>

    <include>
      <uri>model://bird</uri>
      <name>bird_2</name>
      <pose>50.0 50.0 3.2 0 0 0</pose>
    </include>

    <include>
      <uri>model://bird</uri>
      <name>bird_3</name>
      <pose>50.0 50.0 3.2 0 0 0</pose>
