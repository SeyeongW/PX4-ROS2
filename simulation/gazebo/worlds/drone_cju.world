<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Real-scale Cheongju University Main Complex Stadium only. -->
  <world name="drone_cju">
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8066</gravity>

    <scene>
      <ambient>0.58 0.60 0.62 1</ambient>
      <background>0.62 0.75 0.88 1</background>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <sky/>
    </scene>
    <light type="directional" name="sun">
      <pose>100 100 300 0 0 0</pose>
      <diffuse>0.90 0.88 0.82 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>DRONE CJU - Cheongju University Stadium</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.58 0.60 0.62</ambient_light>
        <background_color>0.62 0.75 0.88</background_color>
        <camera_pose>110 -20 120 0 0.60 2.10</camera_pose>
        <camera_clip><near>0.2</near><far>1000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="WorldControl" name="World control">
        <play_pause>true</play_pause><step>true</step><start_paused>true</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <sim_time>true</sim_time><real_time_factor>true</real_time_factor>
      </plugin>
    </gui>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <!-- The stadium model is at ENU (28.403, 115.589). This southwest
           origin georeferences that model centre to 36.654417, 127.495904. -->
      <latitude_deg>36.6533752165</latitude_deg>
      <longitude_deg>127.4955858675</longitude_deg>
      <elevation>74.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Collision-only physics pad for the stadium footprint; the dedicated
         stadium model supplies the visible surface without a duplicate layer. -->
    <model name="stadium_ground">
      <static>true</static>
      <pose>28.402605907228356 115.5890134880474 0 0 0 1.6807520696705394</pose>
      <link name="ground">
        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>226.8 128.3 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <include>
      <uri>model://drone_cju_track_stadium</uri>
      <name>drone_cju_track_stadium</name>
      <pose>28.402605907228356 115.5890134880474 0 0 0 1.6807520696705394</pose>
    </include>
    <include>
      <uri>model://drone_cju_track_running_track</uri>
      <name>drone_cju_track_running_track</name>
      <pose>28.402605907228356 115.5890134880474 0 0 0 1.6807520696705394</pose>
    </include>

    <!-- Four exact mission barriers in stadium-local coordinates. -->
    <model name="mission_obstacles">
      <static>true</static>
      <pose>28.402605907228356 115.5890134880474 0 0 0 1.6807520696705394</pose>
      <link name="barriers">
        <collision name="barrier_1_collision"><pose>-44 0 5 0 0 0</pose><geometry><box><size>0.35 4.5 10</size></box></geometry></collision>
        <collision name="barrier_2_collision"><pose>-34 1.5 5 0 0 0</pose><geometry><box><size>0.35 4.5 10</size></box></geometry></collision>
        <collision name="barrier_3_collision"><pose>-24 -1.5 5 0 0 0</pose><geometry><box><size>0.35 4.5 10</size></box></geometry></collision>
        <collision name="barrier_4_collision"><pose>-14 1.5 5 0 0 0</pose><geometry><box><size>0.35 4.5 10</size></box></geometry></collision>
        <visual name="barrier_1"><pose>-44 0 5 0 0 0</pose><geometry><box><size>0.35 4.5 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_2"><pose>-34 1.5 5 0 0 0</pose><geometry><box><size>0.35 4.5 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_3"><pose>-24 -1.5 5 0 0 0</pose><geometry><box><size>0.35 4.5 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_4"><pose>-14 1.5 5 0 0 0</pose><geometry><box><size>0.35 4.5 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <frame name="drone_spawn"><pose>37.74461362761062 30.970166134855617 2.051 0 0 0.109955742876</pose></frame>
    <frame name="trailer_spawn"><pose>37.74461362761062 30.970166134855617 0 0 0 0.109955742876</pose></frame>
    <include>
      <uri>model://moving_platform_aruco_velocity</uri>
      <name>trailer</name>
      <pose>37.74461362761062 30.970166134855617 0 0 0 0.109955742876</pose>
    </include>

    <!-- PX4 SITL dynamically creates the x500 on the trailer deck. -->
  </world>
</sdf>
