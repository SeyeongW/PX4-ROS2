<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Real-scale Cheongju University Main Complex Stadium only. -->
  <world name="drone_cju">
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8066</gravity>

    <scene>
      <ambient>0.58 0.60 0.62 1</ambient>
      <background>0.62 0.75 0.88 1</background>
      <grid>false</grid>
      <origin_visual>false</origin_visual>
      <sky/>
    </scene>
    <light type="directional" name="sun">
      <pose>100 100 300 0 0 0</pose>
      <diffuse>0.90 0.88 0.82 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>DRONE CJU - Cheongju University Stadium</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.58 0.60 0.62</ambient_light>
        <background_color>0.62 0.75 0.88</background_color>
        <camera_pose>110 -20 120 0 0.60 2.10</camera_pose>
        <camera_clip><near>0.2</near><far>1000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="WorldControl" name="World control">
        <play_pause>true</play_pause><step>true</step><start_paused>true</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <sim_time>true</sim_time><real_time_factor>true</real_time_factor>
      </plugin>
    </gui>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <!-- World ENU georeference; the integer stadium map frame is declared
           separately below at the selected OSM endpoint. -->
      <latitude_deg>36.6533752165</latitude_deg>
      <longitude_deg>127.4955858675</longitude_deg>
      <elevation>74.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Positive mission coordinates from the integer south-west staging
         origin; +x is east-ish and +y north-ish. -->
    <frame name="stadium_endpoint">
      <pose>-10.639652792208 64.993290731978 0 0 0 0.110080031259</pose>
    </frame>
    <frame name="stadium_center">
      <pose relative_to="stadium_endpoint">44 46 0 0 0 0</pose>
    </frame>

    <!-- One low grass/earth pad fills gaps between the requested facilities. -->
    <model name="stadium_ground">
      <static>true</static>
      <pose relative_to="stadium_endpoint">0 0 0 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <pose>46 49 -1 0 0 0</pose>
          <geometry><box><size>128 226 2</size></box></geometry>
        </collision>
        <visual name="stadium_ground_surface">
          <pose>46 49 -0.03 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>128 226 0.04</size></box></geometry>
          <material>
            <ambient>0.16 0.25 0.13 1</ambient>
            <diffuse>0.16 0.25 0.13 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://drone_cju_track_stadium</uri>
      <name>drone_cju_track_stadium</name>
      <pose relative_to="stadium_endpoint">0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://drone_cju_track_running_track</uri>
      <name>drone_cju_track_running_track</name>
      <pose relative_to="stadium_endpoint">0 0 0 0 0 0</pose>
    </include>

    <!-- Twenty-five fixed integer centres in x=0..50, y=0..51. -->
    <model name="mission_obstacles">
      <static>true</static>
      <pose relative_to="stadium_endpoint">0 0 0 0 0 0</pose>
      <link name="barriers">
        <collision name="barrier_1_collision"><pose>33 10 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_2_collision"><pose>18 39 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_3_collision"><pose>21 25 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_4_collision"><pose>49 41 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_5_collision"><pose>31 36 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_6_collision"><pose>45 12 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_7_collision"><pose>39 21 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_8_collision"><pose>42 51 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_9_collision"><pose>17 18 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_10_collision"><pose>22 33 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_11_collision"><pose>44 33 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_12_collision"><pose>24 14 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_13_collision"><pose>39 0 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_14_collision"><pose>30 23 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_15_collision"><pose>49 4 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_16_collision"><pose>21 3 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_17_collision"><pose>15 34 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_18_collision"><pose>42 41 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_19_collision"><pose>35 49 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_20_collision"><pose>28 46 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_21_collision"><pose>12 48 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_22_collision"><pose>50 23 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_23_collision"><pose>12 8 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_24_collision"><pose>30 1 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <collision name="barrier_25_collision"><pose>12 25 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry></collision>
        <visual name="barrier_1"><pose>33 10 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_2"><pose>18 39 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_3"><pose>21 25 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_4"><pose>49 41 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_5"><pose>31 36 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_6"><pose>45 12 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_7"><pose>39 21 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_8"><pose>42 51 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_9"><pose>17 18 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_10"><pose>22 33 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_11"><pose>44 33 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_12"><pose>24 14 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_13"><pose>39 0 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_14"><pose>30 23 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_15"><pose>49 4 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_16"><pose>21 3 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_17"><pose>15 34 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_18"><pose>42 41 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_19"><pose>35 49 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_20"><pose>28 46 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_21"><pose>12 48 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_22"><pose>50 23 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_23"><pose>12 8 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
        <visual name="barrier_24"><pose>30 1 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.90 0.78 1</ambient><diffuse>0.95 0.90 0.78 1</diffuse></material></visual>
        <visual name="barrier_25"><pose>12 25 5 0 0 0</pose><geometry><box><size>0.45 0.35 10</size></box></geometry><material><ambient>0.95 0.32 0.05 1</ambient><diffuse>0.95 0.32 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <frame name="drone_spawn"><pose relative_to="stadium_endpoint">5 0 2.051 0 0 1.570796326795</pose></frame>
    <frame name="trailer_spawn"><pose relative_to="stadium_endpoint">5 0 0 0 0 1.570796326795</pose></frame>
    <include>
      <uri>model://moving_platform_aruco_velocity</uri>
      <name>trailer</name>
      <pose relative_to="stadium_endpoint">5 0 0 0 0 1.570796326795</pose>
    </include>

    <!-- PX4 SITL dynamically creates the x500 on the trailer deck. -->
  </world>
</sdf>
