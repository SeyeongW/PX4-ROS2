<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    Isolated working copy of mpc_landing_200m_moving.world.
    All changed visual assets use DRONE_CJU_TRACK-specific model directories;
    the source world and models are not modified by this variant. A dedicated
    coordinate contract supplies this world name to the landing stack.
  -->
  <world name="DRONE_CJU_TRACK">
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8066</gravity>

    <scene>
      <ambient>0.58 0.60 0.62 1</ambient>
      <background>0.62 0.75 0.88 1</background>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
      <sky/>
    </scene>
    <light type="directional" name="sun">
      <pose>100 100 300 0 0 0</pose>
      <diffuse>0.90 0.88 0.82 1</diffuse>
      <specular>0.10 0.10 0.10 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>DRONE CJU TRACK - Red Track / Smooth Grandstand Roof</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.58 0.60 0.62</ambient_light>
        <background_color>0.62 0.75 0.88</background_color>
        <camera_pose>130 -10 180 0 0.72 2.25</camera_pose>
        <camera_clip><near>0.2</near><far>1000</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager"/>
      <plugin filename="InteractiveViewControl" name="Interactive view control"/>
      <plugin filename="CameraTracking" name="Camera Tracking"/>
      <plugin filename="EntityTree" name="Entity tree"/>
      <plugin filename="WorldControl" name="World control">
        <play_pause>true</play_pause><step>true</step><start_paused>true</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <sim_time>true</sim_time><real_time_factor>true</real_time_factor>
      </plugin>
    </gui>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>36.65440</latitude_deg>
      <longitude_deg>127.49591</longitude_deg>
      <elevation>74.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <model name="experiment_ground">
      <static>true</static>
      <pose>70 120 0 0 0 0</pose>
      <link name="ground">
        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>280 280 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>280 280 0.1</size></box></geometry>
          <material>
            <ambient>0.30 0.34 0.30 1</ambient>
            <diffuse>0.42 0.46 0.42 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="map_boundary">
      <static>true</static>
      <link name="boundary">
        <visual name="south"><pose>70 -20 0.006 0 0 0</pose><geometry><box><size>280 0.20 0.012</size></box></geometry><material><ambient>1 0.82 0.05 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
        <visual name="north"><pose>70 260 0.006 0 0 0</pose><geometry><box><size>280 0.20 0.012</size></box></geometry><material><ambient>1 0.82 0.05 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
        <visual name="west"><pose>-70 120 0.006 0 0 0</pose><geometry><box><size>0.20 280 0.012</size></box></geometry><material><ambient>1 0.82 0.05 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
        <visual name="east"><pose>210 120 0.006 0 0 0</pose><geometry><box><size>0.20 280 0.012</size></box></geometry><material><ambient>1 0.82 0.05 1</ambient><diffuse>1 0.82 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <include>
      <uri>model://drone_cju_track_stadium</uri>
      <name>drone_cju_track_stadium</name>
      <pose>28.402605907228356 115.5890134880474 0 0 0 1.6807520696705394</pose>
    </include>
    <include>
      <uri>model://drone_cju_track_running_track</uri>
      <name>drone_cju_track_running_track</name>
      <pose>28.402605907228356 115.5890134880474 0 0 0 1.6807520696705394</pose>
    </include>

    <frame name="drone_spawn"><pose>30 30 0 0 0 0</pose></frame>
    <frame name="trailer_spawn"><pose>37.071067811865476 37.071067811865476 0 0 0 0</pose></frame>
    <include>
      <uri>model://moving_platform_aruco_velocity</uri>
      <name>trailer</name>
      <pose>37.071067811865476 37.071067811865476 0 0 0 0</pose>
    </include>

    <!-- PX4 SITL dynamically creates x500_city_rgbd_lidar at (30,30,0). -->
  </world>
</sdf>
