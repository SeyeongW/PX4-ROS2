<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="iris_down_camera_runway">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <!-- Everything outside the painted track is BLACK: background set to 0 0 0
         and the procedural <sky> removed (with a sky present, ogre2 draws its
         gradient and ignores the background colour). Ambient kept high so the
         track itself stays brightly lit against the black void. -->
    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0 0 0</background>
    </scene>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane and runway removed by request: only the painted track is
         left in the world. The platform is kinematic (VelocityControl, gravity
         off) and the drone rides ON it, so neither needs a collision ground;
         the down camera looks at the platform marker, not the ground. -->

    <!-- BLACK ground: a large matte-black plate so everything outside the track
         reads as black in BOTH camera views (not just the empty background). It
         is VISUAL-ONLY (no <collision>) so it never interferes with the drone's
         landing physics, and sits at top z=0.004 — just below the track surface
         (z=0.0075..0.0125) so the painted track always renders on top with no
         z-fighting. Centred on the track centre (0, 36.8) and 2 km wide to fill
         any camera frame. Material ambient/diffuse/emissive all 0 → stays black
         even under the scene's full (1 1 1) ambient light. -->
    <model name="black_ground">
      <static>true</static>
      <pose>0 36.8 -0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2000 2000 0.01</size></box></geometry>
          <material>
            <ambient>0 0 0 1</ambient>
            <diffuse>0 0 0 1</diffuse>
            <specular>0 0 0 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- 400 m athletic track: red lane band bounded by TWO white lines,
         auto-generated by gazebo/gen_track_model.py. The lane CENTRELINE lower
         straight sits on y=0 (track centre at (0, 36.8)), so the platform/drone
         spawned at (3,0) facing +x (east) start centred BETWEEN the two lines.
         The platform's forward camera sees both lines and track_follower_node
         keeps it midway between them (the white centroid = the lane centre). -->
    <include>
      <uri>model://running_track</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Moving 1.0 m platform with the ArUco DICT_4X4_50 ID=0 marker on top; the
         drone lands ON TOP of it. moving_marker_node (started by run_sim.sh)
         teleports it along a trajectory and streams its (E,N). Spawn 1 m from the
         drone (0,0); box origin is at the bottom so z=0 sits it on the ground and
         the marker top is at z=1.0 (= controller's platform_height).
         Run `python3 gazebo/gen_aruco_model.py` once to generate the texture.
         For the old flat-ground demo, include model://aruco_marker_0 instead and
         set platform_height:=0. -->
    <include>
      <uri>model://aruco_platform</uri>
      <pose>3 0 0 0 0 0</pose>
    </include>

    <!-- Drone spawns ON TOP of the (moving) platform/truck, secured by the
         DetachableJoint declared in aruco_platform/model.sdf. The platform top is
         at z=1.0 and the iris sits 0.195 m above its own origin, so z=1.195 rests
         it on the truck. Same XY as the platform spawn (3,0) so the joint locks in
         a zero lateral offset. moving_marker_node releases the joint at arm, and
         the drone takes off FROM the moving truck. (For the old ground-launch demo
         put it back at "0 0 0.195" and remove the DetachableJoint plugin.) -->
    <include>
      <uri>model://iris_with_down_camera</uri>
      <pose degrees="true">3 0 1.195 0 0 90</pose>
    </include>

  </world>
</sdf>
