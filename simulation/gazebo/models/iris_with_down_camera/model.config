<?xml version="1.0"?>
<model>
  <name>Iris with Downward Camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>SeyeongW</name>
    <email>seyeong186@gmail.com</email>
  </author>

  <description>
    3DR Iris quadrotor (ArduPilot SITL ready) with a fixed downward-facing
    RGB camera rigidly mounted under the base_link. Based on
    ardupilot_gazebo's iris_with_ardupilot model. The camera publishes on the
    gz topic /down_camera/image (and /down_camera/camera_info), which can be
    bridged to ROS 2 via ros_gz_bridge.
  </description>
</model>
