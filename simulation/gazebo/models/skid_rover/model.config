<?xml version="1.0"?>
<model>
  <name>skid_rover</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Skid-steer ground rover flown by an ArduPilot Rover SITL instance through the
    ArduPilotPlugin (FDM port 9012 for a second -I1 instance). Four driven wheels
    (left pair / right pair) yaw the vehicle by speed difference; no steering hinge.
    Carries an ArUco DICT_4X4_50 ID=0 marker on its flatbed top as the drone's
    precision-landing target, plus a forward line-following camera. Reuses the
    texture from aruco_marker_0 (run gazebo/gen_aruco_model.py once to generate it).
  </description>
</model>
