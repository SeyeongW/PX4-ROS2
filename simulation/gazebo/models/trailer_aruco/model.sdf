<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="trailer_aruco">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="base_link">
      <gravity>false</gravity>
      <!-- The body bottom remains 5 cm above z=0 to avoid initial penetration. -->
      <visual name="body_visual">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry><box><size>5.0 2.5 1.1</size></box></geometry>
        <material>
          <ambient>0.42 0.24 0.04 1</ambient>
          <diffuse>0.60 0.34 0.06 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
      <collision name="body_collision">
        <pose>0 0 0.60 0 0 0</pose>
        <geometry><box><size>5.0 2.5 1.1</size></box></geometry>
      </collision>

      <visual name="landing_deck_visual">
        <pose>0 0 1.20 0 0 0</pose>
        <geometry><box><size>5.5 3.0 0.1</size></box></geometry>
        <material>
          <ambient>0.30 0.30 0.30 1</ambient>
          <diffuse>0.38 0.38 0.38 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <collision name="landing_deck_collision">
        <pose>0 0 1.20 0 0 0</pose>
        <geometry><box><size>5.5 3.0 0.1</size></box></geometry>
      </collision>

      <!-- The PNG has a 60 px quiet zone around its 400 px ArUco square.
           A 1.30 m plane therefore renders the detectable marker at 1.00 m. -->
      <visual name="aruco_marker_visual">
        <pose>0 0 1.251 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>1.3 1.3</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>model://aruco_marker_0/materials/textures/aruco_0.png</albedo_map>
            <metalness>0.0</metalness>
            <roughness>1.0</roughness>
          </metal></pbr>
        </material>
      </visual>

      <inertial>
        <pose>0 0 0.65 0 0 0</pose>
        <mass>1500</mass>
        <inertia>
          <ixx>932.5</ixx>
          <iyy>3276.25</iyy>
          <izz>3906.25</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/trailer/cmd_vel</topic>
      <link_name>base_link</link_name>
    </plugin>
  </model>
</sdf>
