<?xml version="1.0"?>
<sdf version="1.9">
  <model name="aruco_marker_1">
    <!-- NON-static so the moving_marker_node can teleport it (set_pose) SMOOTHLY:
         a static model's pose is not streamed every step, so teleporting it makes
         the visual flicker/ghost between its spawn pose and the commanded pose.
         As a dynamic model its pose IS streamed each step → smooth motion.
         gravity=false + no collision ⇒ it stays exactly where placed and never
         falls (it's a ground decal); when the mover is off it just sits at spawn. -->
    <static>false</static>
    <link name="link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <!-- Physical size: 0.8 m × 0.8 m including white border -->
            <size>0.8 0.8</size>
          </plane>
        </geometry>
        <material>
          <!-- gz-sim PBR <metal> defaults metalness=1.0 → a fully-metallic
               surface with no reflection map renders BLACK. Force non-metallic
               + rough so the albedo texture shows; ambient/diffuse keep it lit. -->
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <!-- PNG generated by gazebo/gen_aruco_model.py -->
              <albedo_map>model://aruco_marker_1/materials/textures/aruco_1.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
