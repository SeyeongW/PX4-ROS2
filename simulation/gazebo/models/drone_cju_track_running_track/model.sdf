<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Smooth red 8-lane track; materials are embedded in the OBJ/MTL. -->
  <model name="drone_cju_track_running_track">
    <static>true</static>
    <link name="track_link">
      <visual name="continuous_red_surface">
        <pose>0 0 0 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://drone_cju_track_running_track/meshes/running_track_surface.obj</uri><scale>1 1 1</scale></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
