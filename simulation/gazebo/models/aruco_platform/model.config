<?xml version="1.0"?>
<model>
  <name>aruco_platform</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Moving 1.0 m-tall box "vehicle" with an ArUco DICT_4X4_50 ID=0 marker on its
    top face; the drone lands ON TOP of it. Reuses the texture from aruco_marker_0
    (run simulation/gazebo/gen_aruco_model.py once to generate it).
  </description>
</model>
