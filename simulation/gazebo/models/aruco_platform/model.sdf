<?xml version="1.0"?>
<sdf version="1.9">
  <!-- A moving "vehicle" the drone lands ON TOP of: a 1.2×1.2×1.0 m box with the
       ArUco marker on its top face (z = 1.0). moving_marker_node teleports this
       model along a trajectory (set_pose every tick) and streams its (E,N).

       Kinematic-by-teleport: non-static so its pose is streamed each step (a
       static model teleported by set_pose flickers), gravity off and a LARGE
       mass so the landing drone can neither make it fall nor shove it aside, and
       the per-tick set_pose overrides any residual contact motion. Model origin
       is at the BOTTOM centre, so set_pose z=0 puts the box on the ground and the
       marker top at z = 1.0 (= platform_height for the controller). -->
  <model name="aruco_platform">
    <static>false</static>
    <link name="link">
      <gravity>false</gravity>
      <inertial>
        <mass>100.0</mass>
        <inertia>
          <ixx>20.0</ixx><iyy>20.0</iyy><izz>24.0</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Box body (origin at bottom → centre raised 0.5 m). MODERATE surface
           friction: enough to carry a velocity-matched drone along, but not so
           high that a leg touching with a little relative velocity catches and
           trips the drone over (mu=100 made it flip). The real fix for the slide
           is matching the platform velocity at touchdown, not brute friction. -->
      <collision name="body_col">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="body_vis">
        <pose>0 0 0.5 0 0 0</pose>
        <geometry><box><size>1.2 1.2 1.0</size></box></geometry>
        <material>
          <ambient>0.25 0.28 0.32 1</ambient>
          <diffuse>0.30 0.34 0.40 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- ArUco marker on the top face, just above z = 1.0 so it is not z-fighting
           with the box top. Same texture/material trick as aruco_marker_0 (force
           non-metallic so the albedo PNG shows). Texture reused from that model. -->
      <visual name="marker_vis">
        <pose>0 0 1.001 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>0.8 0.8</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://aruco_marker_0/materials/textures/aruco_0.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- ============================================================== -->
      <!-- Forward-looking camera for TRACK-LINE following.                -->
      <!-- Mounted at the FRONT-TOP of the box (box front face = x+0.6,    -->
      <!-- top = z+1.0), pitched ~35 deg down so the optical +X axis looks -->
      <!-- forward-and-down at the white guide line a couple metres ahead. -->
      <!-- track_follower_node thresholds the white line in this image and -->
      <!-- steers the platform (cmd_vel) to keep it centred. The camera    -->
      <!-- rides with the box (same link), so it always points along the   -->
      <!-- platform's forward (+x body) direction as it turns. -->
      <!-- ============================================================== -->
      <visual name="front_cam_vis">
        <pose>0.60 0 0.85 0 0.61 0</pose>
        <geometry><box><size>0.05 0.08 0.05</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <gz_frame_id>aruco_platform/front_camera</gz_frame_id>
        <pose>0.60 0 0.85 0 0.61 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>front_camera/image</topic>
        <camera>
          <!-- Wide FOV (~92 deg) so BOTH lane lines (2 m apart) stay in frame
               even at the near rows where the lane spans widest in the image. -->
          <horizontal_fov>1.60</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>1000</far>
          </clip>
          <optical_frame_id>aruco_platform/front_camera_optical</optical_frame_id>
        </camera>
      </sensor>
    </link>

    <!-- Secure the drone to the truck while it rides along. A fixed joint between
         this platform's link (parent) and the iris base_link (child) holds the
         disarmed drone rigidly on the moving truck so it neither slides nor flips,
         regardless of friction. moving_marker_node publishes gz.msgs.Empty on the
         <topic> below the instant the drone arms, which severs the joint and frees
         the drone to take off FROM the moving platform.
         NOTE: child_model is the NESTED model "iris_with_standoffs" (iris_with_
         down_camera includes it), not the top model — DetachableJoint resolves the
         child model by Name and then looks up child_link as a DIRECT link of it, so
         it cannot reach base_link through the outer "iris_with_standoffs::base_link"
         scope. The drone must spawn ON this platform's top (world sets z=1.195). -->
    <plugin filename="gz-sim-detachable-joint-system"
            name="gz::sim::systems::DetachableJoint">
      <parent_link>link</parent_link>
      <child_model>iris_with_standoffs</child_model>
      <child_link>base_link</child_link>
      <topic>/aruco_platform/detach</topic>
      <suppress_initial_detach>true</suppress_initial_detach>
    </plugin>

    <!-- Drive the truck by VELOCITY (not teleport) so the fix-jointed drone is
         carried with real momentum: when the joint releases at arm the drone keeps
         the truck's 3 m/s and lifts off cleanly INSTEAD of being left behind and
         tripped over (teleport imparts no velocity). moving_marker_node streams the
         trajectory velocity as gz.msgs.Twist on this topic. Smooth motion also
         keeps the drone's EKF happy (no per-tick teleport jumps). -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/model/aruco_platform/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
